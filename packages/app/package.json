{
	"name": "electrobun-vue",
	"version": "1.0.0",
	"type": "module",
	"description": "Electrobun app with Vue and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"electrobun": "1.18.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@vitejs/plugin-vue": "^6.0.8",
		"concurrently": "^10.0.4",
		"typescript": "npm:typescript-native-bridge@latest",
		"vite": "^8.2.1",
		"vue": "^3.5.41",
		"vue-tsc": "^3.3.9"
	}
}
