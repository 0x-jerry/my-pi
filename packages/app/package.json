{
	"name": "@my-pi/app",
	"version": "1.0.0",
	"type": "module",
	"description": "my-pi desktop shell and Vue UI (Electrobun + JSON-RPC over WebSocket)",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"check": "vue-tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@0x-jerry/utils": "^6.6.0",
		"@comark/vue": "^0.6.2",
		"@my-pi/core": "workspace:*",
		"@my-pi/shared": "workspace:*",
		"@shikijs/themes": "^4.4.3",
		"@vueuse/core": "^14.4.0",
		"beautiful-mermaid": "^1.1.3",
		"comark": "^0.6.2",
		"electrobun": "1.18.1",
		"element-plus": "^2.14.4",
		"katex": "^0.18.4",
		"normalize.css": "^8.0.1",
		"shiki": "^4.4.3",
		"vue": "^3.5.41",
		"vue-router": "^5.2.0"
	},
	"devDependencies": {
		"@iconify-json/hugeicons": "^1.2.33",
		"@types/bun": "^1.3.14",
		"@types/katex": "^0.16.8",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/test-utils": "^2.4.11",
		"concurrently": "^10.0.4",
		"jsdom": "^30.0.1",
		"typescript": "npm:typescript-native-bridge@latest",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.9"
	}
}
