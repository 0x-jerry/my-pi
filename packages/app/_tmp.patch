+  padding: 4px 8px;
+  font-family: inherit;
+  transition: color 0.2s ease;
+}
+.logo-ok {
+  color: var(--ok);
+}
+.logo-warn {
+  color: var(--warn);
+}
+.logo-offline {
+  color: var(--fg-dim);
+}
+.rail-items {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  width: 100%;
+}
+.rail-spacer {
+  flex: 1;
+}
+.rail-btn {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+  padding: 8px 4px;
+  border: 1px solid transparent;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--fg-dim);
+  cursor: pointer;
+  font-family: inherit;
+  font-size: 11px;
+}
+.rail-btn:hover {
